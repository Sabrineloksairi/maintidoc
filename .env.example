# Copier ce fichier en .env (jamais versionné) puis adapter si besoin. Aucune valeur secrète.

# Qdrant lancé par docker compose
QDRANT_URL=http://localhost:6333
# Alternative sans Docker : Qdrant embarqué sur disque (décommenter)
# QDRANT_PATH=data/qdrant_local

# PostgreSQL (métadonnées) – choisir un mot de passe local, ne jamais le versionner
POSTGRES_PASSWORD=a_definir_localement
POSTGRES_DSN=postgresql://maintidoc:a_definir_localement@localhost:5432/maintidoc

# MinIO (fichiers originaux : figures, pages, photos)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=maintidoc
MINIO_ROOT_PASSWORD=a_definir_localement_8_caracteres_min
MINIO_BUCKET=maintidoc

# OCR : pages scannées (tesseract | rapidocr) et texte sur photos (rapidocr | tesseract)
MAINTIDOC_OCR=tesseract
MAINTIDOC_OCR_PHOTO=rapidocr
# Windows : chemin de tesseract.exe et du dossier contenant fra.traineddata
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=D:\maintidoc\tessdata

# Modèles (téléchargés depuis Hugging Face au premier lancement)
MAINTIDOC_MODELE_TEXTE=BAAI/bge-m3
MAINTIDOC_ENCODEUR_IMAGE=openclip-xlmr
HF_HOME=D:\hf_cache

# Découpage (caractères)
MAINTIDOC_TAILLE_PASSAGE=900
MAINTIDOC_CHEVAUCHEMENT=150
